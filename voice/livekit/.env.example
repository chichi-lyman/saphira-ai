# LiveKit Cloud (https://cloud.livekit.io/)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Google AI Studio — Gemini free tier (LLM + optional STT fallback)
GEMINI_API_KEY=your_gemini_api_key

# ElevenLabs — required for human, intimate spoken voice
# LiveKit plugin reads ELEVEN_API_KEY; monorepo also uses ELEVENLABS_API_KEY
ELEVEN_API_KEY=your_elevenlabs_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Production brand voice: your own Chelsea clone from ElevenLabs
# Leave unset to use the soft-intimate public "Samantha" style voice for demos
# ELEVENLABS_VOICE_ID=your_chelsea_clone_voice_id
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional LLM override
# SAPHIRA_VOICE_LLM=gemini-1.5-flash
