# Runtime
PORT=8000
SAPHIRA_ALLOWED_ORIGINS=http://localhost:3000

# Persistence (set in Render/Kubernetes; never commit secrets)
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Billing / Commerce (never commit real secrets)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional model/provider credentials used by existing Saphira integrations
OPENAI_API_KEY=
GEMINI_API_KEY=

# Enterprise identity / security
SAPHIRA_ENV=production
