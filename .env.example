# Saphira AI Environment Configuration Template
# Copyright © 2026 Chelsea Megan Woods
# Copy to .env and fill in your values
# NEVER commit .env file to git

# ==============================================================================
# CORE SYSTEM CONFIGURATION
# ==============================================================================
NODE_ENV=development
SYSTEM_STATUS_VARIABLE=OPERATIONAL
WORKSPACE_DEVELOPER_NAME=chichi-lyman

# ==============================================================================
# DEPLOYMENT CONFIGURATION
# ==============================================================================
RAILWAY_PUBLIC_DOMAIN=localhost:8000
VERCEL_URL=localhost:3000

# FastAPI Server
API_HOST=0.0.0.0
API_PORT=8000

# ==============================================================================
# AI MODEL API KEYS
# ==============================================================================

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI GPT-4o
OPENAI_API_KEY=sk-proj-your_openai_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your_claude_key_here

# XAI Grok (for avatar generation)
XAI_API_KEY=your_xai_api_key_here
GROK_API_KEY=your_grok_api_key_here

# ==============================================================================
# VOICE & TEXT SYNTHESIS
# ==============================================================================

# ElevenLabs TTS (Chelsea voice clone)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_chelsea_voice_id_here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
SAPHIRA_TTS_PROVIDER=elevenlabs

# ==============================================================================
# DATABASE & PERSISTENCE
# ==============================================================================

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/saphira_db

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# SMART HOME & IOT
# ==============================================================================

# Home Assistant
HOME_ASSISTANT_URL=http://192.168.1.100:8123
HOME_ASSISTANT_LONG_LIVED_TOKEN=your_ha_long_lived_token_here

# Matter/Thread Console Bridge
CONSOLE_BRIDGE_IP=192.168.1.99

# ==============================================================================
# WEARABLE & BIOMETRIC DATA
# ==============================================================================

# Wearable API (Fitbit, Apple Watch, etc.)
WEARABLE_API_KEY=your_wearable_api_key_here
WEARABLE_SYNC_INTERVAL=300  # seconds

# ==============================================================================
# COMMUNICATION SERVICES
# ==============================================================================

# Telegram Bot (for notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Twilio (SMS/WhatsApp)
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================================================
# MUSIC & MEDIA
# ==============================================================================

# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/spotify/callback

# ==============================================================================
# GOOGLE SERVICES
# ==============================================================================

# Gmail & Google Drive (OAuth tokens)
GMAIL_API_OAUTH_TOKEN=ya29.a0Ax4x...your_gmail_oauth_token
GOOGLE_DRIVE_OAUTH_TOKEN=ya29.a0Ax4x...your_drive_oauth_token
GOOGLE_CALENDAR_API_KEY=your_google_calendar_api_key_here

# ==============================================================================
# PERFORMANCE & LIMITS
# ==============================================================================

# Device Command Execution
DEVICE_COMMAND_TIMEOUT=2.5
MAX_DEVICE_RETRIES=2

# Agent Memory
AGENT_ZERO_MAX_MEMORY_GB=8
LIVE_ORCHESTRATOR_MAX_AGENTS=7

# Lyra Creative Compliance
LYRA_COMPLIANCE_MODE=STRICT_CLAMP
LYRA_APPROVAL_REQUIRED=true

# ==============================================================================
# LOCAL PATHS (Development Only)
# ==============================================================================

DESKTOP_MOUNT_PATH=/Users/chichi-lyman/Desktop
SCRIPTS_DIR=/Users/chichi-lyman/saphira-ai/scripts

# ==============================================================================
# SECURITY & SECRETS
# ==============================================================================

# JWT/Auth Tokens
SECRET_KEY=your_super_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================

ENABLE_WEBGPU=true
ENABLE_BIOMETRIC_STRESS=true
ENABLE_IOT_CONTROL=true
ENABLE_VOICE_SYNTHESIS=true
ENABLE_AVATAR_GENERATION=true

# ==============================================================================
# LOGGING & DEBUGGING
# ==============================================================================

LOG_LEVEL=INFO
DEBUG_MODE=false
VERBOSE_LOGGING=false

# ==============================================================================
# NOTES
# ==============================================================================
# 
# 1. NEVER commit .env to git — it contains secrets
# 2. Use .env.local for development overrides
# 3. Use .env.production in production (set in deployment platform)
# 4. Rotate API keys monthly (especially OpenAI, Elevenlabs)
# 5. For local development, copy this file to .env and fill in values
#
# Example local setup:
#   cp .env.example .env
#   # Edit .env with your local values
#   python -m uvicorn main:app --reload
#
