# Saphira AI production environment template
# Copy to .env and fill in real credentials. NEVER commit .env.

PORT=8000
ENVIRONMENT=production
SAPHIRA_ENV=production
LOG_LEVEL=INFO
PRODUCTION_DOMAIN_URL=https://your-domain.example
SAPHIRA_ALLOWED_ORIGINS=https://your-domain.example

OPENAI_API_KEY=
GEMINI_API_KEY=
SEARCH_API_KEY=
SAPHIRA_MODEL=
SAPHIRA_AWARENESS_MODEL=gemini-2.5-flash

POSTGRES_USER=chelsea_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=saphira_god_memory
DATABASE_URL=postgresql+asyncpg://chelsea_admin:change-me@saphira-db:5432/saphira_god_memory
REDIS_URL=redis://saphira-redis:6379/0
CELERY_BROKER_URL=redis://saphira-redis:6379/0
CELERY_RESULT_BACKEND=redis://saphira-redis:6379/1

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
RESEND_API_KEY=
RESEND_FROM=Saphira AI <onboarding@your-verified-domain.example>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SAPHIRA_SENTINEL_SECRET=
SAPHIRA_JWT_SECRET=
SAPHIRA_ENCRYPTION_KEY=
SAPHIRA_ADMIN_AUDIT_KEY=

XAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
SAPHIRA_TTS_PROVIDER=
SAPHIRA_WAKE_WORD_ENABLED=false
SAPHIRA_LOCAL_CAMERA_ENABLED=false
SAPHIRA_LOCAL_MIC_ENABLED=false
