# Saphira AI runtime environment template
# Copy to .env for local development. Never commit actual credentials.
PORT=8000
ENVIRONMENT=development
SAPHIRA_ENV=development
LOG_LEVEL=INFO
PRODUCTION_DOMAIN_URL=http://localhost:3000
SAPHIRA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SAPHIRA_API_URL=http://localhost:8000/api
SAPHIRA_BASE_URL=http://localhost:8000

# AI providers
OPENAI_API_KEY=
SAPHIRA_EMBEDDING_MODEL=text-embedding-3-small
SAPHIRA_MEMORY_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
SEARCH_API_KEY=
SAPHIRA_MODEL=
SAPHIRA_AWARENESS_MODEL=gemini-2.5-flash

# Security / persistence
# AI-native web research (Firecrawl / Tavily / Browserbase)
# Any one of these (or SEARCH_API_KEY) enables live web grounding for all agents.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_BASE_URL=https://www.browserbase.com/v1

# --- Security ---
SAPHIRA_SENTINEL_SECRET=
SAPHIRA_JWT_SECRET=
SAPHIRA_ENCRYPTION_KEY=
SAPHIRA_ADMIN_AUDIT_KEY=
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/saphira
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Celery / Redis background jobs
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# --- PostgreSQL / Redis ---
POSTGRES_USER=chelsea_admin
POSTGRES_PASSWORD=
POSTGRES_DB=saphira_god_memory
DATABASE_URL=
REDIS_URL=redis://saphira-redis:6379/0
CELERY_BROKER_URL=redis://saphira-redis:6379/0
CELERY_RESULT_BACKEND=redis://saphira-redis:6379/1

# Stripe test keys and configured recurring Price ID
# Never place live keys in a client app or source control.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ID=

# Communications
RESEND_API_KEY=
RESEND_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL=

# Optional speech provider
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
SAPHIRA_TTS_PROVIDER=

# Device features stay opt-in
SAPHIRA_LOCAL_CAMERA_ENABLED=false
SAPHIRA_LOCAL_MIC_ENABLED=false
SAPHIRA_WAKE_WORD_ENABLED=false
SAPHIRA_WS_URL=
SAPHIRA_DEVICE_GATEWAY_URL=
SAPHIRA_DEVICE_SHARED_SECRET=

# --- Twilio (SMS / Voice) ---
# Outbound calls and SMS require policy approval (confirmed=True).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL=

# --- MCP (Model Context Protocol) ---
# Optional. When set, Saphira auto-connects these servers on startup.
# MCP_FILESYSTEM_ROOT=/absolute/path/to/allowed/directory
# MCP_GITHUB_TOKEN=ghp_xxxxxxxx   (or reuse GITHUB_TOKEN)
