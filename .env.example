# Copy to .env and fill in real values. Never commit real keys.

# ── Core AI providers ───────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GROK_API_KEY=

# Multi-model routing
SAPHIRA_FAST_MODEL=gemini-flash
SAPHIRA_HEAVY_MODEL=gemini-pro
SAPHIRA_LOCAL_MODEL=local-webgpu
ENABLE_LOCAL_MODEL=true
ENABLE_WEBGPU=true

# ── Voice / TTS / STT ───────────────────────────────────────────
SAPHIRA_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional STT for post-wake capture on edge
SAPHIRA_STT_PROVIDER=whisper_local

# ── Wake word (OpenWakeWord on edge / Node) ─────────────────────
SAPHIRA_WAKE_MODEL_PATH=models/wakeword/saphira.onnx
SAPHIRA_WAKE_THRESHOLD=0.55
SAPHIRA_WAKE_COOLDOWN_SEC=2.5
SAPHIRA_API_BASE=http://127.0.0.1:8000
SAPHIRA_NODE_ID=saphira-ears-1

# ── Memory ──────────────────────────────────────────────────────
MEMORY_BACKEND=persistent
MEMORY_TTL=86400
# DATABASE_URL=postgresql://user:pass@localhost/saphira

# ── API server ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Resilience ──────────────────────────────────────────────────
CIRCUIT_BREAKER_THRESHOLD=5
RETRY_MAX_ATTEMPTS=3
BULKHEAD_THREAD_POOL=10

# ── Saphira Visual Avatar (Chelsea Megan Woods likeness) ────────
SAPHIRA_AVATAR_MASTER_URL=

# ── Stripe (optional product surface) ───────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_PRO=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Social (optional) ───────────────────────────────────────────
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# ── Google workspace connectors ─────────────────────────────────
GMAIL_CREDENTIALS_JSON=
GMAIL_TOKEN_JSON=
GOOGLE_CALENDAR_CREDENTIALS=

# ── Automation webhooks ─────────────────────────────────────────
N8N_CROSS_POST_WEBHOOK=
N8N_ONBOARDING_WEBHOOK=
MAKE_WEBHOOK_URL=
