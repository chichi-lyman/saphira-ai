# Saphira AI production environment template
# =============================================================================
# Saphira AI — Environment Template
# =============================================================================
# Copy to .env and fill in real credentials. NEVER commit .env.

# --- Runtime ---
PORT=8000
ENVIRONMENT=production
SAPHIRA_ENV=production
LOG_LEVEL=INFO
PRODUCTION_DOMAIN_URL=https://your-domain.example
SAPHIRA_ALLOWED_ORIGINS=https://your-domain.example

SAPHIRA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PRODUCTION_DOMAIN_URL=http://localhost:3000

# Web / Android public backend endpoint.
# Vercel: set this as the project environment variable SAPHIRA_API_URL.
# Android: GitHub Actions reads the repository variable SAPHIRA_BASE_URL.
SAPHIRA_API_URL=http://localhost:8000/api
SAPHIRA_BASE_URL=http://localhost:8000

# --- AI / search ---
OPENAI_API_KEY=
SAPHIRA_EMBEDDING_MODEL=text-embedding-3-small
SAPHIRA_MEMORY_API_KEY=
GEMINI_API_KEY=
SEARCH_API_KEY=
SAPHIRA_MODEL=
SAPHIRA_AWARENESS_MODEL=gemini-2.5-flash

# AI-native web research (Firecrawl / Tavily / Browserbase)
# Any one of these (or SEARCH_API_KEY) enables live web grounding for all agents.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_BASE_URL=https://www.browserbase.com/v1

# --- Security ---
SAPHIRA_SENTINEL_SECRET=
SAPHIRA_JWT_SECRET=
SAPHIRA_ENCRYPTION_KEY=
SAPHIRA_ADMIN_AUDIT_KEY=

# --- PostgreSQL / Redis ---
POSTGRES_USER=chelsea_admin
POSTGRES_PASSWORD=
POSTGRES_DB=saphira_god_memory
DATABASE_URL=
REDIS_URL=redis://saphira-redis:6379/0
CELERY_BROKER_URL=redis://saphira-redis:6379/0
CELERY_RESULT_BACKEND=redis://saphira-redis:6379/1

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
RESEND_API_KEY=
RESEND_FROM=Saphira AI <onboarding@your-verified-domain.example>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Opt-in local hardware perception. Keep false on server deployments. ---
SAPHIRA_LOCAL_CAMERA_ENABLED=false
SAPHIRA_LOCAL_MIC_ENABLED=false

# --- Optional providers ---
XAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
SAPHIRA_TTS_PROVIDER=
SAPHIRA_WAKE_WORD_ENABLED=false

# --- Commerce / billing ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Device / realtime ---
SAPHIRA_WS_URL=
SAPHIRA_DEVICE_GATEWAY_URL=
SAPHIRA_DEVICE_SHARED_SECRET=

# --- Twilio (SMS / Voice) ---
# Outbound calls and SMS require policy approval (confirmed=True).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL=

# --- MCP (Model Context Protocol) ---
# Optional. When set, Saphira auto-connects these servers on startup.
# MCP_FILESYSTEM_ROOT=/absolute/path/to/allowed/directory
# MCP_GITHUB_TOKEN=ghp_xxxxxxxx   (or reuse GITHUB_TOKEN)

# --- Automation bridges (Zapier / Make / n8n) ---
# Outbound: Saphira → automation tool
N8N_CROSS_POST_WEBHOOK=https://automation.woodsaistudio.com/webhook/cross-post
N8N_ONBOARDING_WEBHOOK=https://automation.woodsaistudio.com/webhook/onboarding
N8N_REVENUE_WEBHOOK=
MAKE_WEBHOOK_URL=
ZAPIER_WEBHOOK_URL=
SAPHIRA_OUTBOUND_WEBHOOKS=

# Inbound: automation tool → Saphira (required in production)
# Header: X-Saphira-Automation-Key
SAPHIRA_AUTOMATION_WEBHOOK_SECRET=
