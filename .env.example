# =============================================================================
# Saphira AI — Local Environment Template (Backend / Runtime)
# =============================================================================
# Usage:
#   1. Copy this file to .env (or .env.local) in the repository root.
#   2. Fill in values for local development only.
#   3. Never commit .env or .env.local — both are listed in .gitignore.
# =============================================================================

# --- Runtime ---
PORT=8000
ENVIRONMENT=development
SAPHIRA_ENV=development
LOG_LEVEL=INFO
SAPHIRA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Persistence (optional for minimal local chat) ---
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
MEMORY_BACKEND=
MEMORY_TTL=

# --- Model / provider credentials (use only what you need locally) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
SAPHIRA_MODEL=
SAPHIRA_REASONING_MODEL=
SAPHIRA_VISION_MODEL=

# --- Voice / TTS (optional) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
SAPHIRA_TTS_PROVIDER=
SAPHIRA_TTS_VOICE=
SAPHIRA_WAKE_WORD_ENABLED=false

# --- Commerce / billing (leave empty unless testing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Security (generate local-only values; do not reuse production secrets) ---
SAPHIRA_JWT_SECRET=
SAPHIRA_ENCRYPTION_KEY=
SAPHIRA_ADMIN_AUDIT_KEY=

# --- Device / realtime (optional) ---
SAPHIRA_WS_URL=
SAPHIRA_DEVICE_GATEWAY_URL=
SAPHIRA_DEVICE_SHARED_SECRET=
