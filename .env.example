# Saphira AI production environment template
# Copy to .env and fill in real credentials. NEVER commit .env.

PORT=8000
ENVIRONMENT=production
SAPHIRA_ENV=production
LOG_LEVEL=INFO
PRODUCTION_DOMAIN_URL=https://your-domain.example
SAPHIRA_ALLOWED_ORIGINS=https://your-domain.example

# Centralized Supabase Auth (server-side; never expose service-role keys)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy compatibility only; prefer SUPABASE_PUBLISHABLE_KEY.
SUPABASE_ANON_KEY=

# Web / Android public backend endpoint
SAPHIRA_API_URL=https://api.your-domain.example/api
SAPHIRA_BASE_URL=https://api.your-domain.example

# Database / workers
DATABASE_URL=
REDIS_URL=redis://saphira-redis:6379/0
CELERY_BROKER_URL=redis://saphira-redis:6379/0
CELERY_RESULT_BACKEND=redis://saphira-redis:6379/1

# AI / search
OPENAI_API_KEY=
SAPHIRA_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
SEARCH_API_KEY=
SAPHIRA_MODEL=
SAPHIRA_AWARENESS_MODEL=gemini-2.5-flash
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Backend-only security / internal service authentication
SAPHIRA_SENTINEL_SECRET=
SAPHIRA_MEMORY_API_KEY=
SAPHIRA_DEVICE_SHARED_SECRET=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ID=

# Email
RESEND_API_KEY=
RESEND_FROM=Saphira AI <onboarding@your-verified-domain.example>

# Optional providers
XAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Automation bridges
SAPHIRA_AUTOMATION_WEBHOOK_SECRET=
N8N_CROSS_POST_WEBHOOK=
N8N_ONBOARDING_WEBHOOK=
N8N_REVENUE_WEBHOOK=
MAKE_WEBHOOK_URL=
ZAPIER_WEBHOOK_URL=
