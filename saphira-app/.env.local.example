# =============================================================================
# Saphira AI™ Web Application — Local Environment Template
# =============================================================================
# Local development only. Production Vercel uses SAPHIRA_API_URL.
#
#   1. From saphira-app/: cp .env.local.example .env.local
#   2. Set the local API URL if FastAPI is not running on localhost:8000.
#   3. Never commit .env.local.
# =============================================================================

# Optional authenticated API credential. Do not place provider secrets here.
VITE_SAPHIRA_API_KEY=

# Local Saphira Core API base, including /api.
VITE_SAPHIRA_API_BASE_URL=http://localhost:8000/api

# Model identifier sent with chat requests.
VITE_SAPHIRA_MODEL=saphira-default
