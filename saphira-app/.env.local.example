# =============================================================================
# Saphira AI™ Web Application — Local Environment Template
# =============================================================================
# Usage:
#   1. From saphira-app/:  cp .env.local.example .env.local
#   2. Replace placeholder values.
#   3. Never commit .env.local (ignored by saphira-app/.gitignore and root .gitignore).
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# =============================================================================

# API key for authenticated calls to the Saphira backend (if required)
VITE_SAPHIRA_API_KEY=

# Backend base URL (local FastAPI default)
VITE_SAPHIRA_API_BASE_URL=http://localhost:8000

# Model identifier sent with chat requests (must match backend capability)
VITE_SAPHIRA_MODEL=saphira-default
